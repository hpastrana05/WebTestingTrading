# Backend
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
API_HOST=0.0.0.0
API_PORT=8000
# How often to evaluate alert rules in the background (seconds). 0 = off.
ALERT_CHECK_INTERVAL_SECONDS=60

# Frontend: leave empty in Docker so the browser calls same-origin /api
# (Next.js proxies to the backend container). Only set this if the API is
# on a different public host than the UI.
# NEXT_PUBLIC_API_URL=
